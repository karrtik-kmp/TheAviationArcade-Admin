# Settings for the Admin's Node server (dist-node/server.mjs). The server keeps a filled copy at envVar/.env in
# the deployment folder, outside the checkout, and starts it with `node --env-file=envVar/.env dist-node/server.mjs`.
# Never commit a filled copy. Every setting the server reads is listed here (tests/node-hosting.test.mjs checks
# it against lib/settings.ts).

# Where the process listens. nginx forwards to it and terminates TLS. Ports: admin 3200, dev admin 3201.
HOST=127.0.0.1
PORT=3201
# The Admin serves only the staff desks. Optional; if set it must be admin, or the server refuses to start.
SITE_SURFACE=admin
# This site's public URL, e.g. https://dev.admin.playairplanegames.com (read by the server scripts, not the app).
SITE_URL=
# The public website that belongs to this Admin: "My account" and "Contribute" in the account menu and
# "Back to the website" on sign-in link here. An http(s) origin, no path. Unset: derived from the admin host
# (dev.admin.<domain> -> https://dev.<domain>), and left out on other hosts.
PUBLIC_SITE_URL=https://dev.playairplanegames.com

# The game backend on this server, reached on loopback (dev backend 3001). Roles come from its account_roles.
GAME_API_BASE_URL=http://127.0.0.1:3001
ROLES_SOURCE=backend
# Mock roles, local only: verified emails, comma-separated. Ignored while ROLES_SOURCE=backend.
# MOCK_ADMIN_EMAILS=
# MOCK_PHOTOGRAPHER_EMAILS=

# Firebase web config of the cloud project airplane-games-9fe1e (public values, but the real ones).
FIREBASE_PROJECT_ID=airplane-games-9fe1e
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=airplane-games-9fe1e.firebaseapp.com
FIREBASE_APP_ID=
# Local Auth emulator only (demo-airplane-games). Never set on a server: the server refuses to start with it.
# FIREBASE_AUTH_EMULATOR_HOST=

# Bunny private photo storage (Media desk, submission photos). The password is the zone's read-write Storage
# Zone Password, never the account API key. Without PHOTO_STORAGE_PROVIDER=bunny, photo routes answer 503.
# PHOTO_STORAGE_PROVIDER=bunny
# BUNNY_STORAGE_ZONE=aviation-arcade-website
# BUNNY_STORAGE_REGION=de
# BUNNY_STORAGE_ENDPOINT=https://de-s3.storage.bunnycdn.com
# BUNNY_STORAGE_PASSWORD=

# Shared demo account (view-only, never admin or photographer). Same uid as the backend's DEMO_ACCOUNT_UID.
# DEMO_ACCOUNT_UID=
# DEMO_LOGIN_EMAIL=
# DEMO_LOGIN_PASSWORD=

# Dev demo waiver (ruling 2026-11-16), DEV ADMIN ONLY. `dev-demo` lets the desks' browser checks accept a photo with no
# licence name and a Plane of the Day item with no factual source; the dev backend (its own DEV_DEMO_WAIVER, _dev
# database only) stays the authority. The server refuses to start with any other value, or unless SITE_URL is a
# https://dev.admin.<domain> origin; pages ignore it on any other host. Never set it on the prod Admin.
# DEV_DEMO_WAIVER=dev-demo
